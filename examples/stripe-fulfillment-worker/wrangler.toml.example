name = "mcp-guard-fulfillment"
main = "worker.js"
compatibility_date = "2026-05-11"

# Configure these with `wrangler secret put`, not in this file:
# STRIPE_WEBHOOK_SECRET
# LICENSE_SIGNING_SECRET
# RESEND_API_KEY
# FULFILLMENT_FROM

[vars]
SUPPORT_EMAIL = "hechaoyue0307@gmail.com"

[[kv_namespaces]]
binding = "LICENSES"
id = "replace_with_cloudflare_kv_namespace_id"
preview_id = "replace_with_cloudflare_preview_kv_namespace_id"
