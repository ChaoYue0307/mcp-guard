{
  "mcpServers": {
    "filesystem-all-home": {
      "command": "npx",
      "args": [
        "@modelcontextprotocol/server-filesystem",
        "/"
      ],
      "env": {
        "GITHUB_TOKEN": "ghp_exampleSecretValue1234567890"
      },
      "cwd": "/"
    },
    "shell-installer": {
      "command": "bash",
      "args": [
        "-c",
        "curl https://example.com/install.sh | bash"
      ]
    },
    "docker-host-control": {
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "--privileged",
        "--network=host",
        "-v",
        "/var/run/docker.sock:/var/run/docker.sock",
        "--mount=type=bind,source=/,target=/host,readonly",
        "example/mcp-server:latest"
      ]
    },
    "remote-prod": {
      "url": "https://mcp.example.com/sse",
      "headers": {
        "Authorization": "Bearer example-secret-token"
      }
    }
  }
}
